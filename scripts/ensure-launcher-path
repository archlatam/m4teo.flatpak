#!/bin/bash

# Make the Omarchy launcher able to see Flatpak apps.
#
# Flatpak writes its desktop entries into <installation>/exports/share, which is
# not one of the default XDG data directories. Arch ships
# /etc/profile.d/flatpak.sh to add them, but that file is only sourced by login
# shells, so a Hyprland session never picks it up: a flatpak installed through
# this plugin is installed correctly and then simply does not appear in the
# launcher. The environment has to be exported from the Hyprland config, which
# is what actually decides the environment the shell and the launcher run in.
#
#   (no argument)  Report whether the launcher can already see Flatpak apps as a
#                  single word, "ok" or "broken", and exit 1 when it cannot. The
#                  panel reads the word rather than the exit code, so a failure
#                  to run this script can never be mistaken for a broken
#                  session, and vice versa.
#   --status       Same check, spelled out for a human.
#   --fix          Write the Hyprland config, reload Hyprland and restart the
#                  shell. Idempotent, and refuses to overwrite a config file
#                  that is not the one it generates.

set -euo pipefail

DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=_shared.sh
source "$DIR/_shared.sh"

HYPR_DIR="$HOME/.config/hypr"
ENVS_FILE="$HYPR_DIR/envs.lua"
HYPRLAND_FILE="$HYPR_DIR/hyprland.lua"
REQUIRE_LINE='require("hypr.envs")'

# The session environment is the only thing worth testing, not the config on
# disk: the config can be written without taking effect until the shell is
# restarted, and something else on the machine may already have solved this, in
# which case there is nothing to do and nothing to warn about.
session_sees_flatpaks() {
  local dirs="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  local dir

  # Split on ":" and compare whole path elements. A substring match is not
  # enough: the directory before "flatpak" is a component like "share" or "lib",
  # not the ":" that separates XDG entries, so requiring a colon right before
  # "/flatpak" would miss both real paths.
  local IFS=:
  for dir in $dirs; do
    # A trailing slash is tolerated, since nothing stops a user writing one.
    if [[ ${dir%/} == */flatpak/exports/share ]]; then
      return 0
    fi
  done

  return 1
}

report_status() {
  if session_sees_flatpaks; then
    echo "The launcher can see Flatpak apps."
    return 0
  fi
  echo "The launcher cannot see Flatpak apps."
  echo "XDG_DATA_DIRS is: ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  echo "It is missing the <installation>/exports/share directory where Flatpak"
  echo "writes its desktop entries, so apps installed through this plugin will"
  echo "not show up until the session environment is fixed."
  return 1
}

# ---------------------------------------------------------------------- check

case "${1-}" in
  "" | --check)
    if session_sees_flatpaks; then
      echo "ok"
      exit 0
    fi
    echo "broken"
    exit 1
    ;;
  --status)
    report_status || exit 1
    exit 0
    ;;
  --fix) ;;
  *)
    fail "usage: ${BASH_SOURCE[0]##*/} [--status | --fix]"
    ;;
esac

# ------------------------------------------------------------------ fix mode

if session_sees_flatpaks; then
  info "The launcher already sees Flatpak apps. Nothing to do."
  exit 0
fi

[[ -f $HYPRLAND_FILE ]] || fail "$HYPRLAND_FILE not found.
This fix writes the Hyprland config so the session exports the Flatpak export
directories. It does not know how to create a Hyprland config from scratch."

# Write envs.lua, but only when it is safe to. If the file is already there and
# is not ours, it belongs to the user: the fix is not worth silently replacing
# somebody's window manager configuration over.
if [[ -e $ENVS_FILE ]]; then
  if grep -qF "XDG_DATA_DIRS" "$ENVS_FILE"; then
    info "$ENVS_FILE already exports XDG_DATA_DIRS. Leaving it alone."
  else
    fail "$ENVS_FILE exists and does not handle XDG_DATA_DIRS, so this script
will not overwrite it.

Add this to it, then run ${BASH_SOURCE[0]##*/} --fix again:

    local data_home = os.getenv(\"XDG_DATA_HOME\") or \"\$HOME/.local/share\"
    hl.env(\"XDG_DATA_DIRS\", data_home
      .. \"/flatpak/exports/share:/var/lib/flatpak/exports/share:\"
      .. (os.getenv(\"XDG_DATA_DIRS\") or \"/usr/local/share:/usr/share\"))"
  fi
else
  info "Writing $ENVS_FILE…"
  cat >"$ENVS_FILE" <<'LUA'
-- Generated by the io.github.archlatam.flatpak plugin. Safe to edit: the
-- plugin's ensure-launcher-path script will not overwrite this file once it
-- exists.
local paths = require("default.hypr.paths")

-- Flatpak exports its .desktop files into <installation>/exports/share, which is
-- not part of the default XDG data dirs. Arch ships /etc/profile.d/flatpak.sh to
-- add them, but that only runs in login shells, never in the Hyprland session, so
-- the app launcher finds no Flatpak apps without this.
--
-- Keep the existing dirs and skip duplicates: this file is re-read on every
-- reload, when os.getenv already returns the value hl.env set last time.
local data_home = os.getenv("XDG_DATA_HOME")
if not data_home or data_home == "" then data_home = paths.home .. "/.local/share" end

local seen = {}
local dirs = {}

local function add(dir)
  if dir and dir ~= "" and not seen[dir] then
    seen[dir] = true
    table.insert(dirs, dir)
  end
end

add(data_home .. "/flatpak/exports/share")
add("/var/lib/flatpak/exports/share")

for dir in (os.getenv("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"):gmatch("[^:]+") do
  add(dir)
end

hl.env("XDG_DATA_DIRS", table.concat(dirs, ":"))
LUA
fi

# Add the require after the last personal override, so it lands with the user's
# own modules rather than in the middle of Omarchy's defaults.
if grep -qF "$REQUIRE_LINE" "$HYPRLAND_FILE"; then
  info "$HYPRLAND_FILE already loads it."
else
  info "Adding the require to $(basename "$HYPRLAND_FILE")…"
  backup="$HYPRLAND_FILE.bak.$(date +%s)"
  cp -a "$HYPRLAND_FILE" "$backup"

  tmp=$(mktemp)
  # shellcheck disable=SC2064  # expand $tmp now, not at trap time
  trap "rm -f '$tmp'" EXIT

  awk -v req="$REQUIRE_LINE" '
    { lines[NR] = $0 }
    END {
      last = 0
      for (i = NR; i >= 1; i--) {
        if (lines[i] ~ /require\("hypr\./) { last = i; break }
      }
      # No personal modules to sit next to: put it at the end, which is where
      # the file invites extra configuration anyway.
      if (last == 0) last = NR
      for (i = 1; i <= NR; i++) {
        print lines[i]
        if (i == last) print req
      }
    }
  ' "$HYPRLAND_FILE" >"$tmp"

  mv "$tmp" "$HYPRLAND_FILE"
  trap - EXIT
  info "Backed up to $(basename "$backup")"
fi

# The config is read at parse time, but hl.env only reaches processes started
# after it, and the shell that hosts the launcher was started before this ran.
# So both steps are needed: reload for the environment, restart for the shell.
if command -v hyprctl >/dev/null 2>&1; then
  info "Reloading Hyprland…"
  hyprctl reload >/dev/null 2>&1 || info "Reload did not report success; carrying on."
  sleep 1
fi

info "Restarting the shell so the launcher picks the new environment up…"
omarchy restart shell >/dev/null 2>&1 || info "Could not restart the shell by itself."

echo
info "Done. Open the panel again and installed apps will be in the launcher."
info "This runs once; the plugin will not ask again."
